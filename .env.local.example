# Local XAMPP MySQL. For Aiven, set DB_SSL=true and download its CA to certs/ca.pem.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=avnadmin
DB_PASSWORD=
DB_DATABASE=defaultdb
DB_SSL=true
DB_SSL_CA=certs/ca.pem
# Secret used to sign the admin session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Optional locally. Vercel provides this after connecting a Blob store.
BLOB_READ_WRITE_TOKEN=
