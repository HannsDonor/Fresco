{
  "name": "fresco-laundry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "e2e:server": "node scripts/check-e2e-port.mjs && cross-env DB_NAME=fresco_laundry_test DB_DATABASE=fresco_laundry_test next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:admin": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "migrate:capacity": "node --env-file-if-exists=.env.local scripts/migrate-add-capacity-settings.mjs",
    "migrate:audit-logs": "node --env-file-if-exists=.env.local scripts/migrate-add-audit-logs.mjs",
    "e2e:db": "cross-env DB_NAME=fresco_laundry_test DB_DATABASE=fresco_laundry_test node --env-file-if-exists=.env.local scripts/prepare-cypress-db.mjs",
    "cy:open": "npm run e2e:db && start-server-and-test e2e:server http://localhost:3000 \"node scripts/run-cypress.mjs open --e2e\"",
    "cy:run": "npm run e2e:db && start-server-and-test e2e:server http://localhost:3000 \"node scripts/run-cypress.mjs run --e2e\"",
    "cy:component:open": "node scripts/run-cypress.mjs open --component",
    "cy:component:run": "node scripts/run-cypress.mjs run --component",
    "test:e2e": "npm run cy:run"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "bcrypt": "^6.0.0",
    "lucide-react": "^1.45.0",
    "mysql2": "^3.24.4",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "cypress": "^16.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
